[formal.topsop.default]
sed -i "s#set(TOPSOP_COMMITID.*)#set(TOPSOP_COMMITID \"$submodule_target_commit\")#g" $integration_cmake_file
sed -i "s#set(TOPSOP_PACKAGE_VERSION.*)#set(TOPSOP_PACKAGE_VERSION \"$TOPSOP_PACKAGE_VERSION\")#g" $integration_cmake_file

[verify.topsop.default]
sed -i "/set(PREBUILD_TOPSOP_XNAS_BASE/ s#.*set#set#g; s#set(PREBUILD_TOPSOP_XNAS_BASE.*#set(PREBUILD_TOPSOP_XNAS_BASE \"$integration_link\")#g" $integration_cmake_file

[formal.caps.default]
sed -i "s#set(PREBUILD_CAPS_COMMIT.*)#set(PREBUILD_CAPS_COMMIT $PREBUILD_CAPS_COMMIT)#g" $integration_cmake_file
sed -i "s#set(PREBUILD_CAPS_DATE.*)#set(PREBUILD_CAPS_DATE $PREBUILD_CAPS_DATE)#g" $integration_cmake_file
sed -i "s#set(PREBUILD_CAPS_VERSION_BIG.*)#set(PREBUILD_CAPS_VERSION_BIG $PREBUILD_CAPS_VERSION_BIG)#g" $integration_cmake_file
sed -i "s#set(PREBUILD_CAPS_BRANCH.*)#set(PREBUILD_CAPS_BRANCH \"$submodule_target_branch\")#g" "$integration_cmake_file"

[verify.caps.default]
sed -i "/set(PREBUILD_XNAS_CAPS_BASE/ s#.*set#set#g; s#set(PREBUILD_XNAS_CAPS_BASE.*#set(PREBUILD_XNAS_CAPS_BASE \"$integration_link\")#g" $integration_cmake_file

[formal.pcals.default]
sed -i "s#set(PCALS_COMMITID.*)#set(PCALS_COMMITID \"$submodule_target_commit\")#g" $integration_cmake_file
sed -i "s#set(PCALS_ECCL_PACKAGE_VERSION.*)#set(PCALS_ECCL_PACKAGE_VERSION \"$PCALS_ECCL_PACKAGE_VERSION\")#g" $integration_cmake_file
sed -i "s#set(PCALS_BRANCH.*)#set(PCALS_BRANCH \"$submodule_target_branch\")#g" $integration_cmake_file

[verify.pcals.default]
sed -i "/set(PCALS_XNAS_LINK/ s#.*set#set#g; s#set(PCALS_XNAS_LINK.*#set(PCALS_XNAS_LINK \"$integration_link\")#g" $integration_cmake_file

[formal.topsgraph.default]
sed -i "s#set(PREBUILD_TOPSGRAPH_COMMIT.*)#set(PREBUILD_TOPSGRAPH_COMMIT \"$submodule_target_commit\")#g" $integration_cmake_file
sed -i "s#set(PREBUILD_TOPSGRAPH_VERSION.*)#set(PREBUILD_TOPSGRAPH_VERSION \"$TOPSGRAPH_PACKAGE_VERSION\")#g" $integration_cmake_file

[formal.torch_gcu.2.x]
sed -i "s#set(TORCH_GCU_COMMITID.*)#set(TORCH_GCU_COMMITID \"$submodule_target_commit\")#g" cmake/2nd/torch_gcu_version.cmake
sed -i "s#set(TORCH_GCU_DAILY_TAG.*)#set(TORCH_GCU_DAILY_TAG \"$TORCH_GCU_DAILY_TAG\")#g" cmake/2nd/torch_gcu_version.cmake


[formal.flash-attention.default]
sed -i "s#set(_COMMIT_ID.*)#set(_COMMIT_ID $submodule_target_commit)#g" $integration_cmake_file
sed -i "s#set(_VERSION.*)#set(_VERSION $FLASH_ATTENTION_PACKAGE_VERSION)#g" $integration_cmake_file

[formal.DeepGEMM.default]
sed -i "s#set(DEEPGEMM_COMMIT .*)#set(DEEPGEMM_COMMIT $submodule_target_commit)#g" cmake/2nd/deepgeem_version.cmake
sed -i "s#set(DEEPGEMM_VERSION .*)#set(DEEPGEMM_VERSION $DEEPGEMM_VERSION)#g" cmake/2nd/deepgeem_version.cmake
